{
    "name": "actor-19-maritime-sanctions-monitor",
    "version": "2.0.0",
    "type": "module",
    "description": "Global Maritime & Vessel Sanctions Monitor: extracts vessel-type entries (name, IMO number, flag, tonnage, owner, sanctions program) from the US Treasury OFAC Specially Designated Nationals (SDN) List, cross-referenced by IMO number against the UN Security Council Consolidated Sanctions List for corroborating designations.",
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "apify": "^3.7.0",
        "cheerio": "1.0.0-rc.12",
        "zod": "^3.23.8",
        "zod-to-json-schema": "^3.23.5"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/node": "^24.0.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.58.0",
        "vitest": "^4.1.0"
    },
    "scripts": {
        "start": "node dist/main.js",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run"
    },
    "author": "Stefano",
    "license": "Apache-2.0"
}
